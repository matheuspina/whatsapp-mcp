# Development stage (used for docker compose watch / local dev with hot reload)
FROM node:20-alpine AS dev

WORKDIR /app

COPY whatsapp-web-ui/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY whatsapp-web-ui/ ./

EXPOSE 8080
ENV PORT=8080
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "run", "dev", "--", "-p", "8080", "-H", "0.0.0.0"]

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY whatsapp-web-ui/package*.json ./

# Install dependencies
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy source files
COPY whatsapp-web-ui/ ./

# Build the static export
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built static files
COPY --from=builder /app/out /usr/share/nginx/html

# Copy nginx config
COPY whatsapp-web-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]

# WhatsApp MCP - Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: API authentication key
# Generate with: openssl rand -hex 32
API_KEY=CHANGEME_USE_openssl_rand_hex_32

# Development mode: Set to "true" to disable API_KEY requirement
# WARNING: Never use in production!
DISABLE_AUTH_CHECK=false

# REQUIRED: web UI login (http://127.0.0.1:8090). Sessions live in the bridge and the
# browser only holds an HttpOnly cookie. Choose a strong password:
#   openssl rand -base64 18
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=CHANGEME_USE_A_STRONG_PASSWORD
# Idle timeout of a session (sliding). Default 24h.
# WEB_UI_SESSION_TTL=24h

# Optional: Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com,https://another-domain.com

# Optional: Bind host for the bridge REST API (default: 127.0.0.1 for local dev; set 0.0.0.0 in Docker)
# API_BIND_HOST=127.0.0.1

# Optional: Disable security checks for development
# WARNING: Never use in production!
# DISABLE_SSRF_CHECK=false
# DISABLE_PATH_CHECK=false

# Optional: Presence ping (PRESENCE_PING_ENABLED=false to stop appearing online to contacts)
# PRESENCE_PING_ENABLED=true
# PRESENCE_PING_INTERVAL=20m

# Presence behaviour: "human" (default) stays offline and only goes online for a short,
# randomised window around outgoing activity. "always_online" restores the legacy mode.
# WA_PRESENCE_MODE=human
# PRESENCE_LINGER_MIN=8s
# PRESENCE_LINGER_MAX=15s

# Optional: Override the SQLite store directory used by the MCP server.
# Default: /app/store (Docker) → <repo>/whatsapp-bridge/store (local) → <repo>/store
# WA_STORE_PATH=/path/to/store

# Optional: Skip the import-time check that messages.db exists. Set to "1" only for tests/lint.
# WA_SKIP_DB_CHECK=0

# --- History sync (how much WhatsApp history to request when pairing) ---
# Only takes effect at pairing time. Changing it later means unlinking the device
# and pairing again. WhatsApp decides what to send: the value is a request, not a
# guarantee. See docs/history-sync.md.
# HISTORY_SYNC_DAYS_LIMIT=365
# HISTORY_SYNC_SIZE_MB=5000
# STORAGE_QUOTA_MB=10240

# --- OAuth 2.1 for the MCP endpoint (optional, off by default). See docs/mcp-oauth.md. ---
# Public origin of the MCP server, as your AI client reaches it (https, or http on localhost).
# Setting it turns OAuth on: the endpoint then requires a bearer token, and the sign-in page
# checks WEB_UI_USERNAME / WEB_UI_PASSWORD. Also accepted as a bearer token: API_KEY.
# MCP_PUBLIC_URL=https://mcp.example.com
# MCP_OAUTH_ACCESS_TOKEN_TTL=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL=2592000

# --- Local search indexer (optional). See docs/search.md. ---
# How often the indexer looks for new messages once it has caught up, and how conversations
# are split into chunks. INDEX_DB_PATH is set by Compose (the index-data volume).
# INDEX_POLL_SECONDS=20
# CHUNK_GAP_MINUTES=30
# CHUNK_MAX_MESSAGES=15
# CHUNK_MAX_CHARS=1500
# CHUNK_OVERLAP=2
# Embeddings are computed locally: fastembed (default), sentence_transformers, ollama, or none for keyword search only.
# The model (about 0.5 GB) downloads on the first start. Use the same values for the indexer and the MCP server.
# EMBEDDING_BACKEND=fastembed
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBED_BATCH_SIZE=32
# OLLAMA_URL=http://host.docker.internal:11434
# The MCP search tools: candidates per retrieval path, a minimum semantic similarity, and the timezone for dates.
# SEARCH_K_FTS=50
# SEARCH_K_VEC=50
# SEARCH_MIN_SIMILARITY=0
# DISPLAY_TZ=America/Bahia

# --- Governance: several numbers, audit, who may see what. See docs/governance.md. ---
# Delete messages older than this many days (0 = keep everything).
# RETENTION_DAYS=0
# Stop recording messages of numbers whose corporate-asset attestation is missing.
# REQUIRE_CORPORATE_CONFIRMATION=false
# Send permission of numbers registered without an explicit choice. false = monitoring only.
# INSTANCE_ALLOW_SEND_DEFAULT=true
# MAX_PENDING_PAIRINGS=5
# --- Media storage (Cloudflare R2, S3, MinIO). Usually configured in the panel, Settings > Media storage.
# Set S3_BUCKET to manage it from here instead (the panel form becomes read-only). See docs/media-storage.md.
# S3_BUCKET=
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=whatsapp/
# S3_KEEP_LOCAL=false
# MEDIA_DOWNLOAD_WORKERS=4
# MEDIA_UPLOAD_WORKERS=4
# Limit what each MCP client may see: a JSON file inside ./store (mounted at /app/store).
# MCP_ACCESS_POLICY=/app/store/access-policy.json
# No MCP tool that acts on WhatsApp, for every client.
# MCP_READ_ONLY=false
# Record MCP tool calls in the bridge's access log.
# MCP_ACCESS_LOG=true

# --- MCP toolsets exposed to the AI client (default: all). See README. ---
# WHATSAPP_MCP_TOOLSETS=core,send,media

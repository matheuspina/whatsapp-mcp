# WhatsApp MCP - Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: API authentication key
# Generate with: openssl rand -hex 32
API_KEY=CHANGEME_USE_openssl_rand_hex_32

# Development mode: Set to "true" to disable API_KEY requirement
# WARNING: Never use in production!
DISABLE_AUTH_CHECK=false

# REQUIRED: web UI login (http://127.0.0.1:8090). Sessions live in the bridge and the
# browser only holds an HttpOnly cookie. Choose a strong password:
#   openssl rand -base64 18
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=CHANGEME_USE_A_STRONG_PASSWORD
# Idle timeout of a session (sliding). Default 24h.
# WEB_UI_SESSION_TTL=24h

# Optional: Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com,https://another-domain.com

# Optional: Bind host for the bridge REST API (default: 127.0.0.1 for local dev; set 0.0.0.0 in Docker)
# API_BIND_HOST=127.0.0.1

# Optional: Disable security checks for development
# WARNING: Never use in production!
# DISABLE_SSRF_CHECK=false
# DISABLE_PATH_CHECK=false

# Optional: Presence ping (PRESENCE_PING_ENABLED=false to stop appearing online to contacts)
# PRESENCE_PING_ENABLED=true
# PRESENCE_PING_INTERVAL=20m

# Presence behaviour: "human" (default) stays offline and only goes online for a short,
# randomised window around outgoing activity. "always_online" restores the legacy mode.
# WA_PRESENCE_MODE=human
# PRESENCE_LINGER_MIN=8s
# PRESENCE_LINGER_MAX=15s

# Optional: Override the SQLite store directory used by the MCP server.
# Default: /app/store (Docker) → <repo>/whatsapp-bridge/store (local) → <repo>/store
# WA_STORE_PATH=/path/to/store

# Optional: Skip the import-time check that messages.db exists. Set to "1" only for tests/lint.
# WA_SKIP_DB_CHECK=0

# --- History sync (how much WhatsApp history to request when pairing) ---
# Only takes effect at pairing time. Changing it later means unlinking the device
# and pairing again. WhatsApp decides what to send: the value is a request, not a
# guarantee. See docs/history-sync.md.
# HISTORY_SYNC_DAYS_LIMIT=365
# HISTORY_SYNC_SIZE_MB=5000
# STORAGE_QUOTA_MB=10240

# --- MCP toolsets exposed to the AI client (default: all). See README. ---
# WHATSAPP_MCP_TOOLSETS=core,send,media
